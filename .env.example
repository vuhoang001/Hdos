# ─────────────────────────────────────────────────────────────────────────────
# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
#
# File .env KHÔNG được commit lên git (đã có trong .gitignore).
# File này (.env.example) được commit để làm tài liệu cho team.
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server ────────────────────────────────────────────────────────────────
# Phải đủ mạnh (chữ hoa + thường + số + ký tự đặc biệt, tối thiểu 8 ký tự).
# Giá trị dưới chỉ dùng cho local dev — server phải thay bằng mật khẩu thật.
MSSQL_SA_PASSWORD=Hdos!DevPass123

# ── JWT ───────────────────────────────────────────────────────────────────────
# Tối thiểu 32 ký tự. Server PHẢI dùng giá trị ngẫu nhiên mạnh.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=hdos-dev-secret-change-me-in-production-!!

# ── Grafana (chỉ cần khi chạy docker-compose.monitoring.yml) ─────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── External Lakehouse Warehouse (cho WarehouseViewSyncer) ────────────────────
# Connection tới Postgres serving "api" schema do team Data Engineering cấp.
# Nếu để trống → LakehouseService vẫn chạy nhưng endpoint /lakehouse/admin/sync/* trả 400.
# Format: Host=...;Port=...;Database=...;Username=...;Password=...
WAREHOUSE_CONN=

# ─────────────────────────────────────────────────────────────────────────────
# Các biến dưới chỉ cần trên SERVER (staging / production).
# Không cần thiết khi chạy local.
# ─────────────────────────────────────────────────────────────────────────────

# GHCR_OWNER=hoanggggf
# IMAGE_TAG=dev-latest                 # hoặc prod-latest
# ASPNETCORE_ENVIRONMENT=Development   # hoặc Production
# ENV_DIR=/opt/hdos-staging            # hoặc /opt/hdos-prod
#                                      # trỏ tới thư mục chứa common.env, authservice.env, ...
