# ── Hdos Superset env (copy → .env, không commit) ───────────────────────
# Các biến này được docker-compose.yml đọc qua ${VAR_NAME}.
# Phase 5 (staging/prod): bắt buộc thay TẤT CẢ default bằng giá trị production.

# Metadata DB
POSTGRES_SUPERSET_PASSWORD=superset_pass

# Flask SECRET_KEY (>=32 ký tự ngẫu nhiên ở prod)
# Tạo nhanh:  openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE-ME-LOCAL-DEV-INSECURE-32-CHARS-X

# Admin user — chỉ áp dụng lần đầu container superset-init chạy
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@hdos.local

# Public URL (dùng cho email/alert/screenshot links — Phase 5+)
SUPERSET_PUBLIC_URL=https://localhost:8443/superset/
