# ─────────────────────────────────────────────────────────────────────────────
# Template cấu trúc file .env trên SERVER (staging hoặc production).
# Copy toàn bộ thư mục này lên /opt/hdos-staging/ hoặc /opt/hdos-prod/
# rồi điền giá trị thật vào từng file.
#
# File này chỉ để tham khảo — KHÔNG dùng trực tiếp.
# ─────────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════════════
# FILE: .env  (dùng với --env-file, chỉ cho docker compose substitution)
# ════════════════════════════════════════════════════════════════════════════
# IMAGE_TAG=dev-latest                  # hoặc prod-latest
# GHCR_OWNER=hoanggggf
# ASPNETCORE_ENVIRONMENT=Development    # hoặc Production
# ENV_DIR=/opt/hdos-staging             # hoặc /opt/hdos-prod


# ════════════════════════════════════════════════════════════════════════════
# FILE: common.env  (inject vào tất cả service, chứa biến dùng chung)
# ════════════════════════════════════════════════════════════════════════════
# MSSQL_SA_PASSWORD=<mật_khẩu_mạnh>
# ConnectionStrings__AuthDb=Server=sqlserver,1433;Database=AuthDb;User Id=sa;Password=<mật_khẩu>;TrustServerCertificate=True;Encrypt=False
# ConnectionStrings__OrderDb=Server=sqlserver,1433;Database=OrderDb;User Id=sa;Password=<mật_khẩu>;TrustServerCertificate=True;Encrypt=False
# ConnectionStrings__NotificationDb=Server=sqlserver,1433;Database=NotificationDb;User Id=sa;Password=<mật_khẩu>;TrustServerCertificate=True;Encrypt=False
# ConnectionStrings__M01Db=Server=sqlserver,1433;Database=M01Db;User Id=sa;Password=<mật_khẩu>;TrustServerCertificate=True;Encrypt=False
# RabbitMq__Host=rabbitmq
# RabbitMq__Port=5672
# Jwt__Secret=<sinh bằng: openssl rand -base64 48>
# Jwt__Issuer=Hdos.Auth
# Jwt__Audience=Hdos.Services
# Jwt__ExpiresMinutes=60


# ════════════════════════════════════════════════════════════════════════════
# FILE: authservice.env  (biến riêng của AuthService)
# ════════════════════════════════════════════════════════════════════════════
# Kestrel__RestPort=8080
# Kestrel__GrpcPort=8081
#
# Ví dụ biến riêng nếu AuthService gửi email xác thực:
# Smtp__Host=smtp.sendgrid.net
# Smtp__Port=587
# Smtp__User=apikey
# Smtp__Password=<sendgrid_api_key>
# Smtp__FromAddress=no-reply@yourdomain.com
#
# Ví dụ OAuth:
# Google__ClientId=<client_id>
# Google__ClientSecret=<client_secret>


# ════════════════════════════════════════════════════════════════════════════
# FILE: orderservice.env  (biến riêng của OrderService)
# ════════════════════════════════════════════════════════════════════════════
# Services__Auth__GrpcUrl=http://authservice:8081
#
# Ví dụ nếu OrderService tích hợp thanh toán:
# Payment__StripeSecretKey=sk_live_...
# Payment__StripeWebhookSecret=whsec_...


# ════════════════════════════════════════════════════════════════════════════
# FILE: notificationservice.env  (biến riêng của NotificationService)
# ════════════════════════════════════════════════════════════════════════════
# Ví dụ push notification:
# Firebase__ProjectId=your-project-id
# Firebase__PrivateKey=<firebase_private_key>
#
# Ví dụ SMS:
# Twilio__AccountSid=ACxxxxxxxx
# Twilio__AuthToken=<auth_token>
# Twilio__FromNumber=+1234567890


# ════════════════════════════════════════════════════════════════════════════
# FILE: m01service.env  (biến riêng của M01Service)
# ════════════════════════════════════════════════════════════════════════════
# Thêm biến riêng của service này ở đây


# ════════════════════════════════════════════════════════════════════════════
# FILE: apigateway.env  (biến riêng của ApiGateway)
# ════════════════════════════════════════════════════════════════════════════
# Thêm biến riêng của gateway ở đây nếu cần
