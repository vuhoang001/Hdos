{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "hdos-auth",
    "Audience": "hdos-api",
    "Secret": "DEV-INSECURE-SECRET-CHANGE-ME-AT-LEAST-32-CHARS",
    "ExpiresMinutes": 480
  },
  "ConnectionStrings": {
    "DataMatchingDb": "Host=localhost;Port=5433;Database=DataMatchingDb;Username=dm_user;Password=dm_pass"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4000", "https://localhost:5000" ]
  },
  "Matching": {
    "WorkerIntervalSeconds": 30
  }
}
