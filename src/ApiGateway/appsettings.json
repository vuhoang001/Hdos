{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "hdos-dev-secret-please-change-me-min-32-chars",
    "Issuer": "Hdos.Auth",
    "Audience": "Hdos.Services"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "orders-health-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/orders/health" }
      },
      "orders-swagger-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/orders/swagger/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "notifications-health-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/notifications/health" }
      },
      "notifications-swagger-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/notifications/swagger/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/notifications/{**catch-all}" }
      },
      "m01-health-route": {
        "ClusterId": "m01-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/m01/health" }
      },
      "m01-swagger-route": {
        "ClusterId": "m01-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/m01/swagger/{**catch-all}" }
      },
      "m01-route": {
        "ClusterId": "m01-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/m01/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-1": { "Address": "http://localhost:5101/" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-1": { "Address": "http://localhost:5102/" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-1": { "Address": "http://localhost:5103/" }
        }
      },
      "m01-cluster": {
        "Destinations": {
          "m01-1": { "Address": "http://localhost:5104/" }
        }
      }
    }
  }
}
